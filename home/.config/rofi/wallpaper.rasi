/* Generated by wallpaper-theme. */

* {
    font:            "Adwaita Sans 11";
    background-color: transparent;
    text-color:      #e7e6e4;
    border:          0px;
    margin:          0px;
    padding:         0px;
    spacing:         0px;

    /* Replace rofi's built-in Solarized palette variables so no default
       light colours leak into alternating rows or mode buttons. */
    background:                    #0f0f0f;
    foreground:                    #e7e6e4;
    lightbg:                       #202020;
    lightfg:                       #bfbbb5;
    normal-background:             transparent;
    normal-foreground:             #e7e6e4;
    alternate-normal-background:   transparent;
    alternate-normal-foreground:   #e7e6e4;
    selected-normal-background:    #b6b3af;
    selected-normal-foreground:    #111111;
    active-background:             #202020;
    active-foreground:             #e7e6e4;
    selected-active-background:    #b6b3af;
    selected-active-foreground:    #111111;
    alternate-active-background:   transparent;
    alternate-active-foreground:   #e7e6e4;
    urgent-background:             #ffb4ab;
    urgent-foreground:             #690005;
    selected-urgent-background:    #ffb4ab;
    selected-urgent-foreground:    #690005;
    alternate-urgent-background:   transparent;
    alternate-urgent-foreground:   #e7e6e4;
    separatorcolor:                #494949;
}

window {
    width:            700px;
    location:         center;
    anchor:           center;
    border:           1px;
    border-color:     #b6b3af66;
    border-radius:    20px;
    background-color: #0f0f0ff7;
    padding:          16px;
}

mainbox {
    spacing: 12px;
}

inputbar {
    background-color: #191919;
    border:           1px;
    border-color:     #494949;
    border-radius:    14px;
    padding:          14px 18px;
    spacing:          14px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: #b6b3af;
    font:       "Adwaita Sans Bold 13";
}

entry {
    text-color:         #e7e6e4;
    placeholder:        "Search applications…";
    placeholder-color:  #918a83;
    cursor:             text;
}

listview {
    columns:          1;
    lines:            8;
    spacing:          4px;
    scrollbar:        false;
    fixed-height:     false;
    background-color: transparent;
    border:           0px;
}

element {
    padding:       11px 14px;
    border-radius: 12px;
    spacing:       14px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
    text-color:       #e7e6e4;
}

element normal.urgent,
element alternate.urgent {
    background-color: #ffb4ab;
    text-color:       #690005;
}

element normal.active,
element alternate.active {
    background-color: #202020;
    text-color:       #e7e6e4;
}

element selected.normal,
element selected.active,
element selected.urgent {
    background-color: #b6b3af;
    text-color:       #111111;
}

element-icon {
    size:         28px;
    border-radius: 7px;
}

element-text {
    vertical-align: 0.5;
    text-color:    inherit;
}

mode-switcher {
    spacing: 6px;
}

button {
    background-color: #191919;
    text-color:       #bfbbb5;
    border:           0px;
    border-radius:    10px;
    padding:          9px 14px;
}

button selected {
    background-color: #b6b3af;
    text-color:       #111111;
}

scrollbar {
    width:        6px;
    handle-color: #494949;
    handle-width: 6px;
}

error-message {
    background-color: #ffb4ab;
    text-color:       #690005;
    border-radius:    10px;
    padding:          8px 12px;
}
