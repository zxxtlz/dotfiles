            "ForegroundNegative": d["error"],
            "ForegroundNeutral": d["accent_alt"],
            "ForegroundPositive": d["accent_alt"],
            "DecorationFocus": d["accent"],
            "DecorationHover": d["accent"],
        },
        "Colors:Window": {
            "BackgroundAlternate": d["accent_container"],
            "BackgroundNormal": d["surface_container"],
            "ForegroundNormal": d["text"],
            "ForegroundInactive": d["text_dim"],
            "ForegroundActive": d["accent"],
            "ForegroundLink": d["accent"],
            "ForegroundVisited": d["accent_dim"],
            "ForegroundNegative": d["error"],
            "ForegroundNeutral": d["accent_alt"],
            "ForegroundPositive": d["accent_alt"],
            "DecorationFocus": d["accent"],
            "DecorationHover": d["accent"],
        },
    }

    out = [
        "[ColorEffects:Disabled]",
        f"Color={csv(d['surface'])}",
        "ColorAmount=0",
        "ColorEffect=0",
        "ContrastAmount=0.65",
        "ContrastEffect=1",
        "IntensityAmount=0.1",
        "IntensityEffect=2",
        "",
        "[ColorEffects:Inactive]",
        "ChangeSelectionColor=true",
        f"Color={csv(d['outline'])}",
        "ColorAmount=0.025",
        "ColorEffect=2",
        "ContrastAmount=0.1",
        "ContrastEffect=2",
        "Enable=false",
        "IntensityAmount=0",
        "IntensityEffect=0",
        "",
    ]

    for section, values in scheme.items():
        out.append(f"[{section}]")
        for key, value in values.items():
            out.append(f"{key}={csv(value)}")
        out.append("")

    out += [
        "[WM]",
        f"activeBackground={csv(d['accent_container'])}",
        f"activeBlend={csv(d['on_accent_container'])}",
        f"activeForeground={csv(d['on_accent_container'])}",
        f"inactiveBackground={csv(d['surface'])}",
        f"inactiveBlend={csv(d['text_dim'])}",
        f"inactiveForeground={csv(d['text_dim'])}",
        "",
    ]
    return "\n".join(out)


def parse_ini(text: str) -> list[tuple[str, list[str]]]:
    sections: list[tuple[str, list[str]]] = []
    current: tuple[str, list[str]] | None = None
    for line in text.splitlines():
        if line.startswith("[") and line.endswith("]"):
            current = (line[1:-1], [])
            sections.append(current)
        elif current is not None:
            current[1].append(line)
    return sections


def write_kde(palette: dict) -> None:
    d = palette["dark"]
    write(
        KDE_SCHEME,
        "[KDE]\ncontrast=4\n\n[General]\nColorScheme=Wallpaper\nName=Wallpaper\n\n"
        + kde_color_sections(d),
    )

    existing = read(KDE_FILE)
    general_extra: list[str] = []
    preserved: list[tuple[str, list[str]]] = []
    for name, lines in parse_ini(existing):
        if name == "General":
            for line in lines:
                if not re.match(r"\s*(ColorScheme|Name)\s*=", line):
                    general_extra.append(line)
        elif name == "KDE" or name.startswith("Colors:") or name == "WM" or name.startswith("ColorEffects:"):
            continue
        else:
            preserved.append((name, lines))

    out = ["[General]", "ColorScheme=Wallpaper", "Name=Wallpaper"]
    out += [line for line in general_extra if line.strip()]
    out.append("")
    out.append("[KDE]")
    out.append("contrast=4")
    out.append("")
    for name, lines in preserved:
        out.append(f"[{name}]")
        out.extend(lines)
        out.append("")
    out.append(kde_color_sections(d))
    write(KDE_FILE, "\n".join(out))


def qt_color_line(d: dict) -> str:
    colors = [
        d["text"],             # windowText
        d["surface_container"],  # button
        "#ffffff",             # light
        "#cacaca",             # midlight
        "#9f9f9f",             # dark
        "#b8b8b8",             # mid
        d["text"],             # text
        "#ffffff",             # brightText
        d["text"],             # buttonText
        d["surface"],          # base
        d["surface"],          # window
        "#000000",             # shadow
        d["accent_container"], # highlight
        d["on_accent_container"],  # highlightedText
        d["accent"],           # link
        d["accent_dim"],       # linkVisited
        d["surface_low"],      # alternateBase
        d["surface_low"],      # NoRole
        d["surface_container"],  # toolTipBase
        d["text"],             # toolTipText
        d["text_faint"],       # placeholderText
        d["accent"],           # accent
    ]
    return ", ".join(colors)


def write_qt(palette: dict) -> None:
    d = palette["dark"]
    color_line = qt_color_line(d)
    content = (
        "[ColorScheme]\n"
        "# Generated by wallpaper-theme\n"
        "active_colors=" + color_line + "\n"
        "disabled_colors=" + color_line + "\n"
        "inactive_colors=" + color_line + "\n"
    )
    target = QT_DIR / "colors" / "wallpaper.conf"
    write(target, content)

    conf_path = QT_DIR / "qt6ct.conf"
    conf = read(conf_path)
    if not conf:
        conf = "[Appearance]\n"
    lines = conf.splitlines()
    seen_path = seen_custom = False
    for i, line in enumerate(lines):
        if line.startswith("color_scheme_path="):
            lines[i] = f"color_scheme_path={target}"
            seen_path = True
        elif line.startswith("custom_palette="):
            lines[i] = "custom_palette=true"
            seen_custom = True
    if not seen_path:
        lines.append(f"color_scheme_path={target}")
    if not seen_custom:
        lines.append("custom_palette=true")
    write(conf_path, "\n".join(lines).rstrip() + "\n")


def write_legacy_noctalia(palette: dict) -> None:
    """Keep the files Noctalia wrote before the switch from staying blue.

    Noctalia regenerates these from the active palette the next time it runs,
    but apps read them immediately, so mirror the wallpaper palette now.
    """
    d = palette["dark"]
    write(
        XDG_DATA / "color-schemes" / "noctalia.colors",
        "[KDE]\ncontrast=4\n\n[General]\nColorScheme=noctalia\nName=noctalia\n\n"
        + kde_color_sections(d),
    )

    color_line = qt_color_line(d)
    write(
        QT_DIR / "colors" / "noctalia.conf",
        "[ColorScheme]\n# Generated by wallpaper-theme; kept in sync with the wallpaper palette.\n"
        "active_colors=" + color_line + "\n"
        "disabled_colors=" + color_line + "\n"
        "inactive_colors=" + color_line + "\n",
    )

    # KDE apps can override the global scheme per app; Dolphin does.
    rc = XDG_CONFIG / "dolphinrc"
    text = read(rc)
    if text and re.search(r"(?m)^\s*ColorScheme\s*=", text):
        write(rc, re.sub(r"(?m)^(\s*ColorScheme\s*=\s*).*$", r"\1Wallpaper", text))


