#!/usr/bin/env python3
"""Theme apps from the current wallpaper.

The palette is extracted locally (no matugen/wallust dependency).  Wallpapers
with no meaningful chroma (like the current black-and-white one) fall back to a
neutral, slightly warm ramp instead of inventing a blue accent.

Commands:
    wallpaper-theme apply [image]   apply the palette once (default: current wallpaper)
    wallpaper-theme watch           re-apply whenever the wallpaper changes
    wallpaper-theme status          print the active palette
"""
from __future__ import annotations

import colorsys
import fcntl
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path.home()
XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
XDG_CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache")
XDG_DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
XDG_STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state")

CACHE = XDG_CACHE / "wallpaper-theme"
PALETTE_FILE = CACHE / "palette.json"

GTK_DIRS = [XDG_CONFIG / "gtk-3.0", XDG_CONFIG / "gtk-4.0"]
KDE_FILE = XDG_CONFIG / "kdeglobals"
KDE_SCHEME = XDG_DATA / "color-schemes" / "Wallpaper.colors"
QT_DIR = XDG_CONFIG / "qt6ct"
ROFI_DIR = XDG_CONFIG / "rofi"
VESKTOP_DIR = XDG_CONFIG / "vesktop" / "settings"
KITTY_DIR = XDG_CONFIG / "kitty"
BTOP_DIR = XDG_CONFIG / "btop"
HYPR_COLORS = XDG_CONFIG / "hypr" / "config" / "wallpaper-colors.lua"
NOCTALIA_DIR = XDG_CONFIG / "noctalia"
NOCTALIA_PALETTE = NOCTALIA_DIR / "palettes" / "Wallpaper.json"

MARK_BEGIN = "/* >>> wallpaper-theme >>> */"
MARK_END = "/* <<< wallpaper-theme <<< */"


# ---------------------------------------------------------------------------
# small helpers
# ---------------------------------------------------------------------------

def log(message: str) -> None:
    print(f"wallpaper-theme: {message}", flush=True)


def run(cmd: list[str], timeout: float = 8.0) -> tuple[int, str, str]:
    try:
        result = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return result.returncode, result.stdout, result.stderr
    except (OSError, subprocess.SubprocessError):
        return 127, "", ""


def read(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return ""


def write(path: Path, content: str, mode: int | None = None) -> bool:
    """Atomically write *content* when it differs from what is already there."""
    old = read(path)
    if old == content:
        if mode is not None:
            try:
                path.chmod(mode)
            except OSError:
                pass
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(content, encoding="utf-8")
    if mode is not None:
        tmp.chmod(mode)
    os.replace(tmp, path)
    return True


def tint(hue: float, sat: float, light: float) -> str:
    r, g, b = colorsys.hls_to_rgb(
        hue % 1.0,
        max(0.0, min(1.0, light)),
        max(0.0, min(1.0, sat)),
    )
    return "#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255))


def lerp(x: float, x0: float, x1: float, y0: float, y1: float) -> float:
    t = max(0.0, min(1.0, (x - x0) / (x1 - x0)))
    return y0 + t * (y1 - y0)


def rgb(hex_color: str) -> tuple[int, int, int]:
    h = hex_color.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def csv(hex_color: str) -> str:
    return ", ".join(str(v) for v in rgb(hex_color))


def luminance(hex_color: str) -> float:
    def channel(value: int) -> float:
        c = value / 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    r, g, b = rgb(hex_color)
    return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b)


def contrast(a: str, b: str) -> float:
    la, lb = luminance(a), luminance(b)
    lo, hi = min(la, lb), max(la, lb)
    return (hi + 0.05) / (lo + 0.05)


def readable_on(color: str) -> str:
    return "#111111" if contrast(color, "#111111") >= contrast(color, "#ffffff") else "#ffffff"


def hypr(hex_color: str) -> str:
    return f"rgba({hex_color.lstrip('#')}ff)"


# ---------------------------------------------------------------------------
# wallpaper discovery
# ---------------------------------------------------------------------------

def get_wallpaper(explicit: str | None = None) -> Path | None:
    if explicit:
        candidate = Path(explicit).expanduser()
        if candidate.is_file():
            return candidate

    # Noctalia draws its own wallpaper layer over the compositor, so its
    # effective path is authoritative while it is running.
    if noctalia_running():
        code, out, _ = run(["noctalia", "msg", "wallpaper-get"], timeout=3)
        if code == 0:
            for line in out.splitlines():
                candidate = Path(line.strip()).expanduser()
                if candidate.is_file():
                    return candidate

    code, out, _ = run(["awww", "query"], timeout=3)
    if code == 0:
        for line in out.splitlines():
            match = re.search(r"currently displaying: image:\s*(.+?)\s*$", line)
            if match:
                candidate = Path(match.group(1)).expanduser()
                if candidate.is_file():
                    return candidate

    for path in (
        XDG_STATE / "ukishima" / "wallpaper",
        XDG_CONFIG / "ukishima" / "wallpaper",
    ):
        value = read(path).strip()
        if value:
            candidate = Path(value).expanduser()
            if candidate.is_file():
                return candidate

    # Noctalia keeps its wallpaper in settings.toml.
    settings = read(XDG_STATE / "noctalia" / "settings.toml")
    section = None
    for line in settings.splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
        elif section == "wallpaper.default":
            match = re.match(r'path\s*=\s*"(.+)"', stripped)
            if match:
                candidate = Path(match.group(1)).expanduser()
                if candidate.is_file():
                    return candidate
    return None


# ---------------------------------------------------------------------------
# palette extraction
# ---------------------------------------------------------------------------

def analyze_image(path: Path) -> dict:
    """Return hue/saturation/mean-lightness for the dominant chromatic family.

    The rule mirrors Ukishima's wallcolors.py: area-dominant chromatic hue (so a
    small vivid spot cannot hijack the theme) and no chroma at all when the
    image really is monochrome.
    """
    try:
        from PIL import Image

        with Image.open(path) as image:
            image = image.convert("RGB")
            image.thumbnail((200, 200))
            quantized = image.quantize(colors=48, method=Image.Quantize.MEDIANCUT)
            palette = quantized.getpalette() or []
            counts = quantized.getcolors() or []
            total = sum(count for count, _ in counts)
            buckets: dict[int, dict] = {}
            weighted_light = 0.0
            chromatic_pixels = 0

            for count, index in counts:
                pos = index * 3
                if pos + 2 >= len(palette):
                    continue
                r, g, b = (palette[pos + i] / 255 for i in range(3))
                h, l, s = colorsys.rgb_to_hls(r, g, b)
                weighted_light += count * l
                if s < 0.15 or l < 0.05 or l > 0.92:
                    continue
                chromatic_pixels += count
                bucket = buckets.setdefault(int(h * 360) // 30 % 12, {"weight": 0.0, "best": None})
                bucket["weight"] += count * s
                score = count * s * (1.0 if 0.12 < l < 0.55 else 0.4)
                if bucket["best"] is None or score > bucket["best"][0]:
                    bucket["best"] = (score, h, s)

            mean_light = weighted_light / total if total else 0.0
            if not buckets or chromatic_pixels < 0.08 * total:
                return {"hue": 0.09, "sat": 0.0, "mean_l": mean_light, "chromatic": False}

            winner = max(buckets.values(), key=lambda item: item["weight"])
            return {
                "hue": winner["best"][1],
                "sat": winner["best"][2],
                "mean_l": mean_light,
                "chromatic": True,
            }
    except Exception:
        return {"hue": 0.09, "sat": 0.0, "mean_l": 0.08, "chromatic": False}


def build_variant(analysis: dict, dark: bool) -> dict:
    hue = analysis["hue"]
    sat = analysis["sat"]
    mean_l = analysis["mean_l"]
    chromatic = analysis["chromatic"]

    if dark:
        base = lerp(mean_l, 0.0, 0.40, 0.045, 0.20)
        steps = [0.0, 0.022, 0.038, 0.065, 0.100, 0.225]
        surface_sat = min(max(sat, 0.30 if chromatic else 0.0), 0.45)
        accent_sat = min(max(sat, 0.30) + 0.12, 0.82) if chromatic else 0.05
        accent_l = 0.70
        text = [(0.90, 0.05), (0.97, 0.03), (0.73, 0.07), (0.54, 0.06), (0.44, 0.05)]
        text_bright_l, text_dim_l, text_faint_l = 0.97, 0.73, 0.54
        outline_l = base + 0.35
        alt_l = 0.86
        container_l = 0.34
    else:
        base = 0.965
        steps = [0.0, -0.035, -0.060, -0.090, -0.125, -0.300]
        surface_sat = min(sat, 0.10)
        accent_sat = min(sat + 0.05, 0.55) if chromatic else 0.05
        accent_l = 0.42
        text = [(0.13, 0.05), (0.07, 0.03), (0.30, 0.08), (0.44, 0.06), (0.54, 0.05)]
        text_bright_l, text_dim_l, text_faint_l = 0.07, 0.30, 0.44
        outline_l = 0.72
        alt_l = 0.30
        container_l = 0.82

    names = [
        "surface",
        "surface_low",
        "surface_container",
        "surface_high",
        "surface_highest",
        "outline",
    ]
    d = {name: tint(hue, surface_sat, base + step) for name, step in zip(names, steps)}
    d["dark"] = dark
    d["accent"] = tint(hue, accent_sat, accent_l)
    d["accent_alt"] = tint(hue, min(accent_sat + 0.08, 0.90), alt_l)
    d["accent_container"] = tint(hue, min(accent_sat + 0.08, 0.90), container_l)
    d["on_accent"] = readable_on(d["accent"])
    d["on_accent_container"] = readable_on(d["accent_container"])
    d["accent_dim"] = tint(hue, surface_sat, outline_l)
    d["text"] = tint(hue, text[0][1], text[0][0])
    d["text_bright"] = tint(hue, text[1][1], text[1][0])
    d["text_dim"] = tint(hue, text[2][1], text[2][0])
    d["text_faint"] = tint(hue, text[3][1], text[3][0])
    d["text_icon"] = tint(hue, 0.07, 0.81 if dark else 0.25)
    d["error"] = "#ffb4ab" if dark else "#ba1a1a"
    d["on_error"] = "#690005" if dark else "#ffffff"

    if dark:
        normal = ["#262626", "#ff6b6b", "#8fd694", "#e6c77a",
                  "#8ab4f8", "#d7a8ff", "#76d4d4", "#e7e6e4"]
        bright = ["#5a5a5a", "#ff9a9a", "#b4e8b8", "#f4dca0",
                  "#a9c8ff", "#e5c2ff", "#9ae6e6", "#ffffff"]
    else:
        normal = ["#3a3a3a", "#b3261e", "#2e7d32", "#8a6d00",
                  "#1f5fa8", "#7b3fa0", "#006a6a", "#5f5f5f"]
        bright = ["#666666", "#d93025", "#388e3c", "#a17f00",
                  "#2b74c4", "#9250b8", "#008080", "#1e1c1a"]

    d["terminal"] = {
        "background": d["surface"],
        "foreground": d["text"],
        "cursor": d["accent"],
        "cursor_text": d["on_accent"],
        "selection_bg": d["accent_container"],
        "selection_fg": d["on_accent_container"],
        "normal": dict(zip(["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"], normal)),
        "bright": dict(zip(["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"], bright)),
    }
    return d


def build_palette(wallpaper: Path, analysis: dict) -> dict:
    return {
        "wallpaper": str(wallpaper),
        "hue": analysis["hue"],
        "sat": analysis["sat"],
        "chromatic": analysis["chromatic"],
        "mean_l": analysis["mean_l"],
        "dark": build_variant(analysis, True),
        "light": build_variant(analysis, False),
    }


# ---------------------------------------------------------------------------
# Noctalia palette + template sync
# ---------------------------------------------------------------------------

def noctalia_json(palette: dict) -> dict:
    def variant(d: dict) -> dict:
        return {
            "primary": d["accent"],
            "on_primary": d["on_accent"],
            "secondary": d["accent_alt"],
            "on_secondary": d["on_accent"],
            "tertiary": d["accent_dim"],
            "on_tertiary": d["text_bright"] if d["dark"] else "#ffffff",
            "error": d["error"],
            "on_error": d["on_error"],
            "surface": d["surface"],
            "on_surface": d["text"],
            "surface_container": d["surface_container"],
            "on_surface_variant": d["text_dim"],
            "outline_variant": d["outline"],
            "shadow": "#000000",
            "hover": d["surface_high"],
            "on_hover": d["text_bright"],
            "terminal": {
                "background": d["terminal"]["background"],
                "foreground": d["terminal"]["foreground"],
                "cursor": d["terminal"]["cursor"],
                "cursor_text": d["terminal"]["cursor_text"],
                "selection_bg": d["terminal"]["selection_bg"],
                "selection_fg": d["terminal"]["selection_fg"],
                "normal": d["terminal"]["normal"],
                "bright": d["terminal"]["bright"],
            },
        }

    return {"version": 2, "dark": variant(palette["dark"]), "light": variant(palette["light"])}


def noctalia_running() -> bool:
    code, _, _ = run(["pgrep", "-x", "noctalia"], timeout=2)
    return code == 0


def update_noctalia_config() -> None:
    path = NOCTALIA_DIR / "config.toml"
    text = read(path)
    if not text:
        return

    theme_match = re.search(r"(?ms)^\[theme\]\s*$.*?(?=^\[|\Z)", text)
    if theme_match:
        block = theme_match.group(0)
        new_block = re.sub(r'(?m)^source\s*=\s*".*?"\s*$', 'source = "custom"', block)
        if "custom_palette" not in new_block:
            new_block = re.sub(
                r'(?m)^(source\s*=\s*"custom"\s*)$',
                r'\1\ncustom_palette = "Wallpaper"',
                new_block,
                count=1,
            )
        text = text[:theme_match.start()] + new_block + text[theme_match.end():]
    else:
        text = text.rstrip() + '\n\n[theme]\nsource = "custom"\ncustom_palette = "Wallpaper"\n'
    write(path, text)


def sync_noctalia(palette: dict) -> None:
    # Intentionally a no-op. Noctalia derives its own palette from the
    # wallpaper (theme.source = "wallpaper", Material tonal scheme), which
    # keeps its text/background contrast pairs readable. This function used
    # to write palettes/Wallpaper.json and force source = "custom" through
    # config.toml and `noctalia msg color-scheme-set custom Wallpaper`,
    # flipping the shell off the wallpaper palette on every wallpaper
    # change. Noctalia regenerates its colors by itself when the wallpaper
    # changes; the other app theming below stays this script's job.
    return


# ---------------------------------------------------------------------------
# GTK / KDE / Qt
# ---------------------------------------------------------------------------

def gtk_css(d: dict, extra_vars: bool = False) -> str:
    lines = [
        f"/* Generated by wallpaper-theme ({'dark' if d['dark'] else 'light'}). */",
        f"@define-color accent_color {d['accent']};",
        f"@define-color accent_bg_color {d['accent']};",
        f"@define-color accent_fg_color {d['on_accent']};",
        f"@define-color destructive_bg_color {d['error']};",
        f"@define-color destructive_fg_color {d['on_error']};",
        f"@define-color error_bg_color {d['error']};",
        f"@define-color error_fg_color {d['on_error']};",
        "",
        f"@define-color window_bg_color {d['surface']};",
        f"@define-color window_fg_color {d['text']};",
        f"@define-color view_bg_color {d['surface']};",
        f"@define-color view_fg_color {d['text']};",
        f"@define-color theme_bg_color {d['surface']};",
        f"@define-color theme_fg_color {d['text']};",
        f"@define-color theme_base_color {d['surface']};",
        f"@define-color theme_text_color {d['text']};",
        f"@define-color theme_selected_bg_color {d['accent']};",
        f"@define-color theme_selected_fg_color {d['on_accent']};",
        f"@define-color headerbar_bg_color {d['surface_container']};",
        f"@define-color headerbar_fg_color {d['text']};",
        f"@define-color headerbar_backdrop_color {d['surface']};",
        f"@define-color popover_bg_color {d['surface_container']};",
        f"@define-color popover_fg_color {d['text']};",
        f"@define-color card_bg_color {d['surface_container']};",
        f"@define-color card_fg_color {d['text']};",
        f"@define-color dialog_bg_color {d['surface']};",
        f"@define-color dialog_fg_color {d['text']};",
        f"@define-color overview_bg_color {d['surface_container']};",
        f"@define-color overview_fg_color {d['text']};",
        f"@define-color sidebar_bg_color {d['surface_container']};",
        f"@define-color sidebar_fg_color {d['text']};",
        f"@define-color sidebar_backdrop_color {d['surface']};",
        f"@define-color sidebar_border_color {d['outline']};",
        f"@define-color secondary_sidebar_bg_color {d['surface']};",
        f"@define-color secondary_sidebar_fg_color {d['text']};",
        f"@define-color insensitive_bg_color {d['surface_high']};",
        f"@define-color insensitive_fg_color {d['text_faint']};",
        f"@define-color borders {d['outline']};",
        f"@define-color unfocused_borders {d['outline']};",
        f"@define-color content_view_bg {d['surface']};",
        f"@define-color placeholder_text_color {d['text_faint']};",
        f"@define-color theme_unfocused_bg_color {d['surface']};",
        f"@define-color theme_unfocused_fg_color {d['text']};",
        f"@define-color theme_unfocused_base_color {d['surface']};",
        f"@define-color theme_unfocused_text_color {d['text']};",
        f"@define-color theme_unfocused_selected_bg_color {d['accent']};",
        f"@define-color theme_unfocused_selected_fg_color {d['on_accent']};",
        "",
        "/* Accent details that named colours alone do not reach. */",
        "headerbar { border-color: @borders; }",
        "entry:focus, spinbutton:focus, button:focus-visible {",
        "    outline-color: @accent_bg_color;",
        "}",
        "progressbar > trough > progress {",
        "    background-color: @accent_bg_color;",
        "}",
        "checkbutton check:checked, radiobutton radio:checked {",
        "    background-color: @accent_bg_color;",
        "    color: @accent_fg_color;",
        "}",
        "",
    ]
    if extra_vars:
        # libadwaita reads CSS custom properties, which plain @define-color
        # does not replace. This keeps its accent from staying on Noctalia's
        # old value until the next template run.
        lines += [
            ":root {",
            f"    --accent-color: {d['accent']};",
            f"    --accent-bg-color: {d['accent']};",
            f"    --accent-fg-color: {d['on_accent']};",
            "}",
            "",
        ]
    return "\n".join(lines)


def ensure_gtk_imports(directory: Path) -> None:
    gtk_css_path = directory / "gtk.css"
    text = read(gtk_css_path)
    if "noctalia.css" not in text:
        text = '@import url("noctalia.css");\n' + text
    if 'wallpaper.css' not in text:
        text = text.rstrip() + '\n@import url("wallpaper.css");\n'
    write(gtk_css_path, text)


