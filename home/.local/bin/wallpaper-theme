def vesktop_css(d: dict) -> str:
    def alpha(h: str, a: float) -> str:
        r, g, b = rgb(h)
        return f"rgba({r}, {g}, {b}, {a:.2f})"

    return f"""{MARK_BEGIN}
:root {{
    --background-primary: {d['surface']};
    --background-secondary: {d['surface_low']};
    --background-secondary-alt: {d['surface']};
    --background-tertiary: {d['surface_container']};
    --background-accent: {d['surface_high']};
    --background-floating: {d['surface_container']};
    --background-base-lowest: {d['surface']};
    --background-base-low: {d['surface_low']};
    --background-base-lower: {d['surface_low']};
    --background-base: {d['surface_container']};
    --background-base-high: {d['surface_high']};
    --background-base-highest: {d['surface_highest']};

    --background-modifier-hover: {alpha(d['accent'], 0.10)};
    --background-modifier-active: {alpha(d['accent'], 0.16)};
    --background-modifier-selected: {alpha(d['accent'], 0.22)};
    --background-modifier-accent: {alpha(d['outline'], 0.55)};
    --background-mentioned: {alpha(d['accent'], 0.08)};
    --background-mentioned-hover: {alpha(d['accent'], 0.14)};

    --header-primary: {d['text_bright']};
    --header-secondary: {d['text_dim']};
    --text-normal: {d['text']};
    --text-muted: {d['text_dim']};
    --text-link: {d['accent']};
    --text-strong: {d['text_bright']};
    --text-default: {d['text']};

    --interactive-normal: {d['text_dim']};
    --interactive-hover: {d['text']};
    --interactive-active: {d['text_bright']};
    --interactive-muted: {d['text_faint']};

    --brand-experiment: {d['accent']};
    --brand-360: {d['accent_alt']};
    --brand-400: {d['accent_alt']};
    --brand-500: {d['accent']};
    --brand-560: {d['accent_dim']};
    --brand-600: {d['accent_dim']};
    --brand-700: {d['outline']};
    --focus-primary: {d['accent']};
    --mention-foreground: {d['accent']};
    --mention-background: {alpha(d['accent'], 0.12)};

    --status-positive: #7bd88f;
    --status-warning: #e6c77a;
    --status-danger: {d['error']};
    --status-idle: #e6c77a;
    --status-offline: {d['text_faint']};

    --button-positive-background: {d['accent']};
    --button-positive-background-hover: {d['accent_alt']};
    --button-danger-background: {d['error']};
    --button-danger-background-hover: #ff8f85;
    --button-secondary-background: {d['surface_high']};
    --button-secondary-background-hover: {d['surface_highest']};
}}
{MARK_END}
"""


def replace_marked(path: Path, block: str) -> None:
    old = read(path)
    if MARK_BEGIN in old and MARK_END in old:
        pattern = re.compile(
            re.escape(MARK_BEGIN) + r".*?" + re.escape(MARK_END) + r"\n?",
            re.DOTALL,
        )
        new = pattern.sub(block, old)
    else:
        new = (old.rstrip() + "\n\n" if old.strip() else "") + block
    write(path, new)


def write_vesktop(palette: dict) -> None:
    settings_path = VESKTOP_DIR / "settings.json"
    try:
        settings = json.loads(read(settings_path) or "{}")
    except json.JSONDecodeError:
        settings = {}
    if settings.get("useQuickCss") is not True:
        settings["useQuickCss"] = True
        write(settings_path, json.dumps(settings, indent=4) + "\n")
    replace_marked(VESKTOP_DIR / "quickCss.css", vesktop_css(palette["dark"]))


# ---------------------------------------------------------------------------
# LibreWolf
# ---------------------------------------------------------------------------

def librewolf_profile() -> Path | None:
    root = XDG_CONFIG / "librewolf" / "librewolf"
    if not root.is_dir():
        return None

    # profiles.ini has two kinds of "Default": one under [Install...] naming the
    # default profile path, and "Default=1" flagging the default [ProfileN].
    default = None
    profiles: dict[str, dict[str, str]] = {}
    install_default = None
    section = ""
    for line in read(root / "profiles.ini").splitlines():
        stripped = line.strip()
        if stripped.startswith("[") and stripped.endswith("]"):
            section = stripped[1:-1]
            if section.startswith("Profile"):
                profiles.setdefault(section, {})
            continue
        match = re.match(r"([A-Za-z0-9_]+)\s*=\s*(.*?)\s*$", stripped)
        if not match:
            continue
        key, value = match.group(1), match.group(2)
        if section.startswith("Install") and key == "Default":
            install_default = value
        elif section.startswith("Profile"):
            profiles[section][key] = value
        elif section == "General" and key == "Default":
            default = value

    for name, data in profiles.items():
        if data.get("Default") == "1" and data.get("Path"):
            default = data["Path"]
    if install_default:
        default = install_default
    if default and (root / default).is_dir():
        return root / default

    candidates = [p for p in root.iterdir() if p.is_dir() and (p / "prefs.js").is_file()]
    if not candidates:
        return None
    return max(candidates, key=lambda p: (p / "prefs.js").stat().st_mtime)


def librewolf_chrome(d: dict) -> str:
    return f"""/* Generated by wallpaper-theme. */

:root {{
    --lwt-accent-color: {d['surface']} !important;
    --lwt-text-color: {d['text']} !important;
    --toolbar-bgcolor: {d['surface_container']} !important;
    --toolbar-color: {d['text']} !important;
    --tab-selected-bgcolor: {d['surface_container']} !important;
    --tab-selected-textcolor: {d['text_bright']} !important;
    --tab-line-color: {d['accent']} !important;
