"""


def librewolf_content(d: dict) -> str:
    return f"""/* Generated by wallpaper-theme. */

:root {{
    scrollbar-color: {d['outline']} {d['surface']};
}}

@-moz-document url("about:blank"), url("about:newtab"), url("about:home") {{
    html, body {{
        background-color: {d['surface']} !important;
        color: {d['text']} !important;
    }}
}}
"""


def write_librewolf(palette: dict) -> None:
    profile = librewolf_profile()
    if not profile:
        return
    chrome = profile / "chrome"
    chrome.mkdir(parents=True, exist_ok=True)
    write(chrome / "wallpaper-theme.css", librewolf_chrome(palette["dark"]))
    write(chrome / "wallpaper-content.css", librewolf_content(palette["dark"]))

    user_chrome = chrome / "userChrome.css"
    text = read(user_chrome)
    if "wallpaper-theme.css" not in text:
        text = '@import url("wallpaper-theme.css");\n' + (("\n" + text) if text.strip() else "")
        write(user_chrome, text)

    user_content = chrome / "userContent.css"
    text = read(user_content)
    if "wallpaper-content.css" not in text:
        text = '@import url("wallpaper-content.css");\n' + (("\n" + text) if text.strip() else "")
        write(user_content, text)

    user_js = profile / "user.js"
    prefs = "\n".join([
        "// >>> wallpaper-theme >>>",
        'user_pref("toolkit.legacyUserProfileCustomizations.stylesheets", true);',
        'user_pref("browser.theme.toolbar-theme", 0);',
        'user_pref("browser.theme.content-theme", 0);',
        'user_pref("ui.systemUsesDarkTheme", 1);',
        'user_pref("layout.css.prefers-color-scheme.content-override", 0);',
        "// <<< wallpaper-theme <<<",
    ])
    old = read(user_js)
    if "// >>> wallpaper-theme >>>" in old:
        new = re.sub(
            r"// >>> wallpaper-theme >>>.*?// <<< wallpaper-theme <<<\n?",
            prefs + "\n",
            old,
            flags=re.DOTALL,
        )
    else:
        new = (old.rstrip() + "\n\n" if old.strip() else "") + prefs + "\n"
    write(user_js, new)


# ---------------------------------------------------------------------------
# terminals
# ---------------------------------------------------------------------------

def write_kitty(palette: dict) -> None:
    t = palette["dark"]["terminal"]
    lines = [
        "# Generated by wallpaper-theme.",
        f"background {t['background']}",
        f"foreground {t['foreground']}",
        f"cursor {t['cursor']}",
        f"cursor_text_color {t['cursor_text']}",
        f"selection_background {t['selection_bg']}",
        f"selection_foreground {t['selection_fg']}",
        f"url_color {t['cursor']}",
        f"active_border_color {t['cursor']}",
        f"inactive_border_color {palette['dark']['outline']}",
        f"active_tab_foreground {t['cursor_text']}",
        f"active_tab_background {t['cursor']}",
        f"inactive_tab_foreground {palette['dark']['text_dim']}",
        f"inactive_tab_background {palette['dark']['surface_container']}",
        f"cursor_trail_color {palette['dark']['text_dim']}",
    ]
    for i, name in enumerate(["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]):
        lines.append(f"color{i} {t['normal'][name]}")
    for i, name in enumerate(["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"], start=8):
        lines.append(f"color{i} {t['bright'][name]}")

    write(KITTY_DIR / "themes" / "wallpaper.conf", "\n".join(lines) + "\n")

    conf_path = KITTY_DIR / "kitty.conf"
    conf = read(conf_path)
    if "include themes/wallpaper.conf" not in conf:
        conf = conf.rstrip() + "\ninclude themes/wallpaper.conf\n"
        write(conf_path, conf)


def write_btop(palette: dict) -> None:
    d = palette["dark"]
    lines = [
        "# btop theme generated by wallpaper-theme",
        f'theme[main_bg]="{d["surface"]}"',
        f'theme[main_fg]="{d["text"]}"',
        f'theme[title]="{d["accent"]}"',
        f'theme[hi_fg]="{d["accent_alt"]}"',
        f'theme[selected_bg]="{d["accent_container"]}"',
        f'theme[selected_fg]="{d["on_accent_container"]}"',
        f'theme[inactive_fg]="{d["text_dim"]}"',
        f'theme[proc_misc]="{d["accent_alt"]}"',
        f'theme[cpu_box]="{d["text_dim"]}"',
        f'theme[mem_box]="{d["text_dim"]}"',
        f'theme[net_box]="{d["text_dim"]}"',
        f'theme[proc_box]="{d["text_dim"]}"',
        f'theme[div_line]="{d["outline"]}"',
    ]
    for name in ("temp", "cpu", "free", "cached", "available", "used", "download", "upload"):
        lines += [
            f'theme[{name}_start]="{d["accent"]}"',
            f'theme[{name}_mid]="{d["accent_alt"]}"',
            f'theme[{name}_end]="{d["accent_dim"]}"',
        ]
    write(BTOP_DIR / "themes" / "wallpaper.theme", "\n".join(lines) + "\n")

    conf_path = BTOP_DIR / "btop.conf"
    conf = read(conf_path)
    if re.search(r'(?m)^color_theme\s*=\s*"(?:noctalia|wallpaper)"\s*$', conf):
        conf = re.sub(
            r'(?m)^color_theme\s*=\s*"(?:noctalia|wallpaper)"\s*$',
            'color_theme = "wallpaper"',
            conf,
        )
        write(conf_path, conf)


# ---------------------------------------------------------------------------
# Hyprland borders
# ---------------------------------------------------------------------------

def hypr_lua(d: dict) -> str:
    return f"""-- Generated by wallpaper-theme from the current wallpaper. Do not edit.
WALLPAPER_ACCENT = "{hypr(d['accent'])}"
WALLPAPER_ACCENT_ALT = "{hypr(d['accent_alt'])}"
WALLPAPER_BORDER_INACTIVE = "{hypr(d['outline'])}"
"""


def apply_hypr(palette: dict) -> None:
    d = palette["dark"]
    write(HYPR_COLORS, hypr_lua(d))

    if not os.environ.get("HYPRLAND_INSTANCE_SIGNATURE"):
        return
    if not any(Path(p).exists() for p in ("/usr/bin/hyprctl", "/bin/hyprctl")):
        return

    accent = hypr(d["accent"])
    accent_alt = hypr(d["accent_alt"])
    inactive = hypr(d["outline"])
    # This build exposes the config as Lua, so keywords are not supported.
    # hl.config() mutates the live config when evaluated.
    code = f"""hl.config({{
    general = {{ col = {{
        active_border = {{ colors = {{ "{accent}", "{accent_alt}" }}, angle = 45 }},
        inactive_border = "{inactive}",
    }} }},
    group = {{
        col = {{
            border_active = "{accent}",
            border_inactive = "{inactive}",
            border_locked_active = "{accent_alt}",
            border_locked_inactive = "{inactive}",
        }},
        groupbar = {{ col = {{
            active = "{accent}",
            inactive = "{inactive}",
            locked_active = "{accent_alt}",
            locked_inactive = "{inactive}",
        }} }},
    }},
    misc = {{ col = {{ splash = "{accent}" }} }},
}})"""
    run(["hyprctl", "eval", code], timeout=5)


# ---------------------------------------------------------------------------
# driver
# ---------------------------------------------------------------------------

def apply(wallpaper: Path, quiet: bool = False) -> bool:
    analysis = analyze_image(wallpaper)
    palette = build_palette(wallpaper, analysis)
    CACHE.mkdir(parents=True, exist_ok=True)
    write(PALETTE_FILE, json.dumps(palette, indent=2) + "\n")

    sync_noctalia(palette)

    for directory in GTK_DIRS:
        write(
            directory / "wallpaper.css",
            gtk_css(palette["dark"], extra_vars=directory.name == "gtk-4.0"),
        )
        ensure_gtk_imports(directory)

    write_kde(palette)
    write_qt(palette)
    write_legacy_noctalia(palette)
    write_rofi(palette)
    write_vesktop(palette)
    write_librewolf(palette)
    write_kitty(palette)
    write_btop(palette)
    apply_hypr(palette)

    if not quiet:
        d = palette["dark"]
        mode = "chromatic" if palette["chromatic"] else "monochrome"
        log(f"{wallpaper.name}: {mode}, accent {d['accent']}, surface {d['surface']}")
        log("updated GTK, KDE, Qt, rofi, Vesktop, LibreWolf, kitty, btop and Hyprland borders")
        if noctalia_running():
            log("Noctalia keeps its own wallpaper-derived palette")
    return True


def watch() -> int:
    CACHE.mkdir(parents=True, exist_ok=True)
    lock_file = (CACHE / "watch.lock").open("w")
    try:
        fcntl.flock(lock_file, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0

    last: tuple | None = None
    while True:
        try:
            wallpaper = get_wallpaper()
            if wallpaper:
                stat = wallpaper.stat()
                signature = (str(wallpaper), stat.st_mtime_ns, stat.st_size)
                if signature != last:
                    try:
                        apply(wallpaper, quiet=True)
                    except Exception as exc:
                        log(f"apply failed: {exc}")
                    last = signature
        except Exception as exc:
            log(f"watch error: {exc}")
        time.sleep(2)


def main() -> int:
    command = sys.argv[1] if len(sys.argv) > 1 else "apply"

    if command in ("apply", "once"):
        wallpaper = get_wallpaper(sys.argv[2] if len(sys.argv) > 2 else None)
        if not wallpaper:
            log("no wallpaper found")
            return 1
        apply(wallpaper)
        return 0

    if command == "watch":
        return watch()

    if command == "status":
        text = read(PALETTE_FILE)
        if text:
            print(text, end="")
            return 0
        wallpaper = get_wallpaper()
        if not wallpaper:
            log("no wallpaper found")
            return 1
        palette = build_palette(wallpaper, analyze_image(wallpaper))
        print(json.dumps(palette, indent=2))
        return 0

    print(__doc__.strip())
    return 2


if __name__ == "__main__":
    sys.exit(main())
