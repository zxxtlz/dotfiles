#!/usr/bin/env bash
# shell-switch - switch the Hyprland desktop shell between Noctalia and Ukishima.
#
#   shell-switch             toggle between the two
#   shell-switch noctalia    switch to Noctalia
#   shell-switch ukishima    switch to Ukishima
#   shell-switch status      show what is running
#   shell-switch autostart   start the last selected shell (used at login)
#   shell-switch guard       watchdog: keep only the saved shell alive
#
# The last selection is remembered in ~/.config/shell-switch/current.
# Exactly one shell is allowed to run at any time: every switch/autostart path
# stops both shells before starting the requested one, and `guard` cleans up if
# a shell is launched directly (e.g. from the application menu).
set -u

UKISHIMA_DIR="${UKISHIMA_DIR:-$HOME/.local/share/quickshell/ukishima}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shell-switch"
STATE_FILE="$CONFIG_DIR/current"
LOCK_FILE="$CONFIG_DIR/lock"
GUARD_LOCK="$CONFIG_DIR/guard.lock"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

mkdir -p "$CONFIG_DIR"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Shell Switch" -i "${2:-applications-system}" "$1" "${3:-}" \
      >/dev/null 2>&1 || true
  fi
}

other_of() {
  if [ "$1" = noctalia ]; then printf 'ukishima\n'; else printf 'noctalia\n'; fi
}

# Print the PIDs of a shell, one per line. Detection is deliberately narrow:
# - noctalia: exact process name (its cmdline is just "noctalia", so a loose
#   `pgrep -f noctalia` would also match this script when called with that arg).
# - ukishima: a quickshell/qs process whose argv contains the exact --path and
#   the Ukishima directory as separate arguments.
shell_pids() {
  case "$1" in
    noctalia)
      pgrep -x noctalia 2>/dev/null || true
      ;;
    ukishima)
      local pid
      for pid in $(pgrep -x 'quickshell|qs' 2>/dev/null || true); do
        if [ -r "/proc/$pid/cmdline" ] &&
          tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -Fxq -- '--path' &&
          tr '\0' '\n' <"/proc/$pid/cmdline" 2>/dev/null | grep -Fxq -- "$UKISHIMA_DIR"; then
          printf '%s\n' "$pid"
        fi
      done
      ;;
  esac
}

running() {
  [ -n "$(shell_pids "$1")" ]
}

wait_for() { # $1 = shell, $2 = number of 100ms tries
  local i
  for ((i = 0; i < $2; i++)); do
    running "$1" && return 0
    sleep 0.1
  done
  return 1
}

stop_shell() { # terminate a shell by PID only (never a broad pkill pattern)
  local name=$1 pids i
  pids=$(shell_pids "$name")
  [ -z "$pids" ] && return 0

  kill $pids 2>/dev/null || true
  for ((i = 0; i < 30; i++)); do
    [ -z "$(shell_pids "$name")" ] && return 0
    sleep 0.1
  done

  pids=$(shell_pids "$name")
  if [ -n "$pids" ]; then
    kill -9 $pids 2>/dev/null || true
  fi
  for ((i = 0; i < 20; i++)); do
    [ -z "$(shell_pids "$name")" ] && return 0
    sleep 0.1
  done
  return 1
}

start_shell() {
  case "$1" in
    noctalia)
      if ! command -v noctalia >/dev/null 2>&1; then
        notify "Cannot start Noctalia" "dialog-error" "The noctalia binary was not found."
        return 1
      fi
      # Close the lock fds in the child: a detached shell would otherwise keep
      # the flock alive forever and block every later switch.
      setsid -f noctalia >/dev/null 2>&1 9>&- 8>&- || return 1
      ;;
    ukishima)
      if [ ! -x "$UKISHIMA_DIR/launch.sh" ]; then
        notify "Cannot start Ukishima" "dialog-error" "No install found at $UKISHIMA_DIR"
        return 1
      fi
      if ! command -v quickshell >/dev/null 2>&1 && ! command -v qs >/dev/null 2>&1; then
        notify "Cannot start Ukishima" "dialog-error" "Quickshell is not installed."
        return 1
      fi
      # Ukishima uses awww for wallpapers; start the daemon if it is not up yet.
      if ! pgrep -x awww-daemon >/dev/null 2>&1 &&
        command -v awww-daemon >/dev/null 2>&1; then
        setsid -f awww-daemon >/dev/null 2>&1 9>&- 8>&- || true
      fi
      setsid -f "$UKISHIMA_DIR/launch.sh" >/dev/null 2>&1 9>&- 8>&- || return 1
      ;;
  esac
}

current() {
  if [ -r "$STATE_FILE" ]; then
    local saved
    saved=$(head -n 1 "$STATE_FILE" 2>/dev/null || true)
    case "$saved" in
      noctalia | ukishima)
        printf '%s\n' "$saved"
        return 0
        ;;
    esac
  fi
  # Fall back to what is actually alive.
  if running ukishima && ! running noctalia; then printf 'ukishima\n'; else printf 'noctalia\n'; fi
}

save() {
  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$1" >"$STATE_FILE"
}

# Stop everything except $1. Used by the watchdog and by autostart.
ensure_only() {
  local keep=$1
  stop_shell "$(other_of "$keep")"
}

switch_to() {
  local target=$1 other
  case "$target" in
    noctalia | ukishima) ;;
    *)
      printf 'shell-switch: unknown shell %s\n' "$target" >&2
      return 2
      ;;
  esac
  other=$(other_of "$target")

  # Fast path: the requested shell is the only one alive.
  if running "$target" && ! running "$other"; then
    save "$target"
    notify "Already using ${target^}" "applications-system" "The ${target^} shell is already active."
    return 0
  fi

  # Core rule: stop BOTH shells, even when the saved state says the target is
  # already current. This is what prevents the two shells from surviving a
  # switch together.
  stop_shell "$other"
  stop_shell "$target"
  if running "$other" || running "$target"; then
    stop_shell "$other"
    stop_shell "$target"
  fi

  if ! start_shell "$target"; then
    stop_shell "$target"
    if start_shell "$other" && wait_for "$other" 100; then
      save "$other"
      notify "Fell back to ${other^}" "dialog-warning" "${target^} could not be started."
    fi
    return 1
  fi

  if ! wait_for "$target" 100; then
    notify "Failed to start ${target^}" "dialog-error" \
      "Check the shell log for details."
    stop_shell "$target"
    if start_shell "$other" && wait_for "$other" 100; then
      save "$other"
    fi
    return 1
  fi

  # Final safety check: drop any stray process of the other shell that might
  # have been started concurrently while we were launching the target.
  if running "$other"; then stop_shell "$other"; fi

  save "$target"
  notify "Switched to ${target^}" "applications-system" "Press Super+Shift+U to toggle shells."
  return 0
}

# Keep exactly the saved shell alive. Intended for a background watchdog.
enforce_saved() {
  local target saved
  saved=$(current)
  case "$saved" in noctalia | ukishima) target=$saved ;; *) target=ukishima ;; esac

  ensure_only "$target"
  if ! running "$target"; then
    start_shell "$target" >/dev/null 2>&1 || return 1
    wait_for "$target" 100 || return 1
  fi
  return 0
}

status() {
  local n u saved
  n=$(shell_pids noctalia)
  u=$(shell_pids ukishima)
  saved=$(current)
  if [ -n "$n" ] && [ -n "$u" ]; then
    printf 'running: both noctalia and ukishima (saved: %s)\n' "$saved"
  elif [ -n "$n" ]; then
    printf 'running: noctalia (saved: %s)\n' "$saved"
  elif [ -n "$u" ]; then
    printf 'running: ukishima (saved: %s)\n' "$saved"
  else
    printf 'running: none (saved: %s)\n' "$saved"
  fi
}

# Serialize all switch/autostart operations. The watchdog only takes the lock
# briefly for each check (see below), so it never blocks a switch.
exec 9>"$LOCK_FILE"

lock_or_exit() {
  if ! flock -w 30 9; then
    printf 'shell-switch: another switch is in progress (timed out)\n' >&2
    exit 1
  fi
}

case "${1:-toggle}" in
  noctalia | ukishima)
    lock_or_exit
    switch_to "$1"
    ;;
  toggle | '')
    if running ukishima; then
      lock_or_exit
      switch_to noctalia
    elif running noctalia; then
      lock_or_exit
      switch_to ukishima
    else
      lock_or_exit
      case "$(current)" in
        ukishima) switch_to noctalia ;;
        *) switch_to ukishima ;;
      esac
    fi
    ;;
  autostart)
    lock_or_exit
    switch_to "$(current)"
    ;;
  guard)
    # Only one watchdog instance.
    exec 8>"$GUARD_LOCK"
    flock -n 8 || exit 0
    while true; do
      if flock -n 9; then
        enforce_saved >/dev/null 2>&1 || true
        flock -u 9
      fi
      sleep 2
    done
    ;;
  status)
    status
    ;;
  -h | --help | help)
    cat <<'EOF'
usage: shell-switch [noctalia|ukishima|toggle|status|autostart|guard]

  (no argument)  toggle between Noctalia and Ukishima
  noctalia       switch to Noctalia
  ukishima       switch to Ukishima
  status         show which shell is active
  autostart      start the last selected shell (used at login)
  guard          watchdog: keep only the saved shell alive
EOF
    ;;
  *)
    printf "shell-switch: unknown argument '%s' (try --help)\n" "$1" >&2
    exit 2
    ;;
esac
