#!/usr/bin/env bash
# shell-switch - switch the Hyprland desktop shell between Noctalia and Ukishima.
#
#   shell-switch             toggle between the two
#   shell-switch noctalia    switch to Noctalia
#   shell-switch ukishima    switch to Ukishima
#   shell-switch status      show what is running
#   shell-switch autostart   start the last selected shell (used at login)
#
# The last selection is remembered in ~/.config/shell-switch/current.
set -u

UKISHIMA_DIR="${UKISHIMA_DIR:-$HOME/.local/share/quickshell/ukishima}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shell-switch"
STATE_FILE="$CONFIG_DIR/current"
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"

notify() {
  if command -v notify-send >/dev/null 2>&1; then
    notify-send -a "Shell Switch" -i "${2:-applications-system}" "$1" "${3:-}" \
      >/dev/null 2>&1 || true
  fi
}

running() {
  case "$1" in
    noctalia)
      pgrep -x noctalia >/dev/null 2>&1
      ;;
    ukishima)
      pgrep -f "quickshell --path $UKISHIMA_DIR" >/dev/null 2>&1 ||
        pgrep -f "$UKISHIMA_DIR/launch.sh" >/dev/null 2>&1
      ;;
    *)
      return 1
      ;;
  esac
}

wait_for() { # $1 = shell, $2 = number of 100ms tries
  local i
  for ((i = 0; i < $2; i++)); do
    running "$1" && return 0
    sleep 0.1
  done
  return 1
}

wait_gone() {
  local i
  for ((i = 0; i < $2; i++)); do
    running "$1" || return 0
    sleep 0.1
  done
  return 1
}

stop_shell() {
  case "$1" in
    noctalia)
      pkill -x noctalia 2>/dev/null || true
      wait_gone noctalia 30 || pkill -9 -x noctalia 2>/dev/null || true
      ;;
    ukishima)
      pkill -f "$UKISHIMA_DIR/launch.sh" 2>/dev/null || true
      pkill -f "quickshell --path $UKISHIMA_DIR" 2>/dev/null || true
      wait_gone ukishima 30 || pkill -9 -f "$UKISHIMA_DIR" 2>/dev/null || true
      ;;
  esac
}

start_shell() {
  case "$1" in
    noctalia)
      if ! command -v noctalia >/dev/null 2>&1; then
        notify "Cannot start Noctalia" "dialog-error" "The noctalia binary was not found."
        return 1
      fi
      setsid -f noctalia >/dev/null 2>&1 || return 1
      ;;
    ukishima)
      if [ ! -x "$UKISHIMA_DIR/launch.sh" ]; then
        notify "Cannot start Ukishima" "dialog-error" "No install found at $UKISHIMA_DIR"
        return 1
      fi
      if ! command -v quickshell >/dev/null 2>&1 && ! command -v qs >/dev/null 2>&1; then
        notify "Cannot start Ukishima" "dialog-error" "Quickshell is not installed."
        return 1
      fi
      # Ukishima uses awww for wallpapers; start the daemon if it is not up yet.
      if ! pgrep -x awww-daemon >/dev/null 2>&1 &&
        command -v awww-daemon >/dev/null 2>&1; then
        setsid -f awww-daemon >/dev/null 2>&1 || true
      fi
      setsid -f "$UKISHIMA_DIR/launch.sh" >/dev/null 2>&1 || return 1
      ;;
  esac
}

current() {
  if [ -r "$STATE_FILE" ]; then
    local saved
    saved=$(head -n 1 "$STATE_FILE" 2>/dev/null || true)
    case "$saved" in
      noctalia | ukishima)
        printf '%s\n' "$saved"
        return 0
        ;;
    esac
  fi
  if running ukishima; then
    printf 'ukishima\n'
  else
    printf 'noctalia\n'
  fi
}

save() {
  mkdir -p "$CONFIG_DIR"
  printf '%s\n' "$1" >"$STATE_FILE"
}

switch_to() {
  local target=$1 cur other
  case "$target" in
    noctalia | ukishima) ;;
    *)
      printf 'shell-switch: unknown shell %s\n' "$target" >&2
      return 2
      ;;
  esac

  cur=$(current)
  if [ "$cur" = "$target" ] && running "$target"; then
    save "$target"
    notify "Already using ${target^}" "applications-system" "The ${target^} shell is already active."
    return 0
  fi

  if [ "$target" = noctalia ]; then other=ukishima; else other=noctalia; fi

  running "$other" && stop_shell "$other"
  running "$target" && stop_shell "$target"

  if ! start_shell "$target"; then
    if start_shell "$other" && wait_for "$other" 100; then
      save "$other"
      notify "Fell back to ${other^}" "dialog-warning" "${target^} could not be started."
    fi
    return 1
  fi

  if ! wait_for "$target" 100; then
    notify "Failed to start ${target^}" "dialog-error" \
      "Check ~/.local/state/ukishima/ukishima.log for details."
    stop_shell "$target"
    if start_shell "$other" && wait_for "$other" 100; then
      save "$other"
    fi
    return 1
  fi

  save "$target"
  notify "Switched to ${target^}" "applications-system" "Press Super+Shift+U to toggle shells."
  return 0
}

case "${1:-toggle}" in
  noctalia | ukishima)
    switch_to "$1"
    ;;
  toggle | '')
    if [ "$(current)" = ukishima ]; then
      switch_to noctalia
    else
      switch_to ukishima
    fi
    ;;
  autostart)
    target=$(current)
    running "$target" && exit 0
    switch_to "$target"
    ;;
  status)
    target=$(current)
    if running "$target"; then
      printf 'running: %s (saved: %s)\n' "$target" "$target"
    elif running noctalia; then
      printf 'running: noctalia (saved: %s)\n' "$target"
    elif running ukishima; then
      printf 'running: ukishima (saved: %s)\n' "$target"
    else
      printf 'running: none (saved: %s)\n' "$target"
    fi
    ;;
  -h | --help | help)
    cat <<'EOF'
usage: shell-switch [noctalia|ukishima|toggle|status|autostart]

  (no argument)  toggle between Noctalia and Ukishima
  noctalia       switch to Noctalia
  ukishima       switch to Ukishima
  status         show which shell is active
  autostart      start the last selected shell (used at login)
EOF
    ;;
  *)
    printf "shell-switch: unknown argument '%s' (try --help)\n" "$1" >&2
    exit 2
    ;;
esac
