#!/usr/bin/env python3
"""Info-ZIP compatible shim backed by Python's zipfile module.

The 'zip' package is not installed on this machine (installing it needs
root), but tools like xtool shell out to `zip`. This shim implements the
commonly used subset of the Info-ZIP CLI:

  zip [-options] archive input...
    -r   recurse into directories
    -q   quiet
    -X   (accepted; we never store extra attributes anyway)
    -y   store symlinks as symlink entries
    -j   junk directory names (store basename only)
    -9..-0 compression level (ignored, always deflate)
    -b, -P, -e and other flags with values are consumed harmlessly

Every invocation is logged to /tmp/opencode/zip-calls.log.
"""
import os
import sys
import stat
import time
import zipfile

LOG = "/tmp/opencode/zip-calls.log"


def log(msg: str) -> None:
    try:
        with open(LOG, "a") as f:
            f.write(msg + "\n")
    except OSError:
        pass


def parse_args(argv):
    """Split argv into (flags:set, archive:str, inputs:[str])."""
    flags = set()
    archive = None
    inputs = []
    # Flags that consume the following argument as their value.
    value_flags = {"b", "P", "i", "x", "U", "s"}

    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg.startswith("-") and len(arg) > 1:
            body = arg.lstrip("-")
            j = 0
            while j < len(body):
                ch = body[j]
                flags.add(ch)
                if ch in value_flags:
                    # consume the rest of the combined flag or next arg
                    if j + 1 < len(body):
                        j = len(body)  # rest of arg is the value
                    else:
                        i += 1  # value is the next argv element
                j += 1
        elif archive is None:
            archive = arg
        else:
            inputs.append(arg)
        i += 1
    return flags, archive, inputs


def add_dir_entry(zf: zipfile.ZipFile, path: str, name: str) -> None:
    st = os.lstat(path)
    mtime = time.localtime(st.st_mtime)[:6]
    zi = zipfile.ZipInfo(name.rstrip("/") + "/", date_time=mtime)
    # directory bit + permissions (typically rwxr-xr-x)
    zi.external_attr = (st.st_mode & 0xFFFF) << 16
    zi.compress_type = zipfile.ZIP_DEFLATED
    zf.writestr(zi, b"")


def add_file(zf: zipfile.ZipFile, path: str, name: str, symlinks: bool) -> None:
    st = os.lstat(path)
    if stat.S_ISLNK(st.st_mode):
        if symlinks:
            zi = zipfile.ZipInfo(name, date_time=time.localtime(st.st_mtime)[:6])
            zi.external_attr = (stat.S_IFLNK | 0o777) << 16
            zi.compress_type = zipfile.ZIP_DEFLATED
            zf.writestr(zi, os.readlink(path))
        else:
            # dereference like zip does without -y
            target = os.path.realpath(path)
            if os.path.isdir(target):
                add_dir_entry(zf, target, name)
            else:
                add_file(zf, target, name, symlinks=False)
        return
    zi = zipfile.ZipInfo.from_file(path, name)
    zi.compress_type = zipfile.ZIP_DEFLATED
    with open(path, "rb") as src:
        zf.writestr(zi, src.read())


def main() -> int:
    flags, archive, inputs = parse_args(sys.argv[1:])
    log("argv: " + repr(sys.argv))

    if archive is None or not inputs:
        sys.stderr.write("zip shim: archive and at least one input required\n")
        return 12

    quiet = "q" in flags
    recurse = "r" in flags
    junk = "j" in flags
    symlinks = "y" in flags

    with zipfile.ZipFile(archive, "w", zipfile.ZIP_DEFLATED) as zf:
        for raw in inputs:
            path = raw.rstrip("/")
            if not junk:
                name = path
            else:
                name = os.path.basename(path)
            if os.path.isdir(path) and not stat.S_ISLNK(os.lstat(path).st_mode):
                if name:
                    add_dir_entry(zf, path, name)
                if recurse:
                    stack = [path]
                    while stack:
                        current = stack.pop()
                        for entry in sorted(os.listdir(current)):
                            full = os.path.join(current, entry)
                            rel = full if not junk else entry
                            st = os.lstat(full)
                            if stat.S_ISDIR(st.st_mode):
                                add_dir_entry(zf, full, rel)
                                stack.append(full)
                            else:
                                add_file(zf, full, rel, symlinks)
            elif os.path.lexists(path):
                add_file(zf, path, name, symlinks)
            else:
                sys.stderr.write(f"zip shim: {path} not found\n")
                return 18

    if not quiet:
        print(f"  adding: {len(inputs)} entr(ies) -> {archive}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
